# Desktop: Ubuntu 24.04, RTX 5060 Ti 16 GB. Source via: source tools/env.sh desktop
# Ports swap on replug — confirm with tools/find.sh if a connection fails.

export MACHINE=desktop
export LEROBOT_DIR="$HOME/GitHub/AnotherOnes/lerobot"
export RUN="uv run"                       # runner prefix; set to "" if you `conda activate lerobot`
export DEVICE=cuda

export ROBOT_TYPE=so100_follower
export ROBOT_ID=my_awesome_follower_arm
export ROBOT_PORT=/dev/ttyACM1

export TELEOP_TYPE=so100_leader
export TELEOP_ID=my_awesome_leader_arm
export TELEOP_PORT=/dev/ttyACM0

# Cameras: resolved to today's /dev/videoN by tools/cameras.sh (run from tools/env.sh).
# CAM_*_PATH is a /dev/v4l/by-path name = the physical USB port. Needed here because the wrist and
# base cameras are the same model with the same serial (SN0001), which by-id cannot tell apart.
# => Plug each camera into the port named below. List them with: ls -l /dev/v4l/by-path/
# CAM_*_ID (by-id, follows the camera to any port) is used as a fallback when the serial is unique.
export CAM_TOP_PATH="pci-0000:0d:00.0-usb-0:7:1.0"      # WENKIA PC-LM7, overhead behind the arm
export CAM_TOP_ID="usb-Sonix_Technology_Co.__Ltd._WENKIA_PC-LM7_SN0001-video-index0"
export CAM_WRIST_PATH="pci-0000:0d:00.0-usb-0:1:1.0"    # Innomaker U20CAM on the gripper
export CAM_BASE_PATH="pci-0000:0d:00.0-usb-0:8:1.0"     # Innomaker U20CAM, side view across the mat
# Verify the assignment before a long session: tools/check_cameras.py writes one PNG per key.
# Wrist and base swapped? Exchange the two _PATH values above (they are identical cameras).

export DATASET_PREFIX=local                # local/<name>: nothing is uploaded
export PUSH_TO_HUB=false
export NUM_WORKERS=8
export BATCH_SIZE=8

# Policy used by tools/demo.sh here (local checkpoint — no download needed).
export DEMO_POLICY="$LEROBOT_DIR/outputs/train/smolvla_so100_medicamentos/checkpoints/last/pretrained_model"
export DEMO_TASK1="agarra la caja de Complejo B"
export DEMO_TASK2="agarra el frasco de zinc"
