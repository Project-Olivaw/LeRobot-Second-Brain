# Desktop: Ubuntu 24.04, RTX 5060 Ti 16 GB. Source via: source tools/env.sh desktop
# Ports swap on replug — confirm with tools/find.sh if a connection fails.

export MACHINE=desktop
export LEROBOT_DIR="$HOME/GitHub/AnotherOnes/lerobot"
export RUN="uv run"                       # runner prefix; set to "" if you `conda activate lerobot`
export DEVICE=cuda

export ROBOT_TYPE=so100_follower
export ROBOT_ID=my_awesome_follower_arm
export ROBOT_PORT=/dev/ttyACM1

export TELEOP_TYPE=so100_leader
export TELEOP_ID=my_awesome_leader_arm
export TELEOP_PORT=/dev/ttyACM0

# Cameras by stable identity (ls -l /dev/v4l/by-id/). tools/cameras.sh (run by env.sh) resolves these to
# today's /dev/videoN index and builds CAM_TOP/CAM_WRIST/CAM_BASE/CAMERAS/CAMERAS_THREE. Indices shift on
# replug (0/2/4 in July, 4/2/- on 2026-09-14) — never hard-code them. MJPG mandatory — see hardware/cameras.md.
export CAM_TOP_ID="usb-Sonix_Technology_Co.__Ltd._WENKIA_PC-LM7_SN0001-video-index0"        # overhead, behind the arm
export CAM_WRIST_ID="usb-Innomaker_Innomaker-U20CAM-1080p-S1_SN0001-video-index0"           # on the gripper
export CAM_BASE_ID="usb-Microdia_Webcam_Vitade_AF-video-index0"                             # TODO confirm: plug it in, ls -l /dev/v4l/by-id/

export DATASET_PREFIX=local                # local/<name>: nothing is uploaded
export PUSH_TO_HUB=false
export NUM_WORKERS=8
export BATCH_SIZE=8

# Policy used by tools/demo.sh here (local checkpoint — no download needed).
export DEMO_POLICY="$LEROBOT_DIR/outputs/train/smolvla_so100_medicament_box/checkpoints/last/pretrained_model"
export DEMO_TASK1="agarra el Complejo B"
export DEMO_TASK2="agarra el frasco de magnesio"
