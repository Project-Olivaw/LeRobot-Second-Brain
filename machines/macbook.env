# MacBook Pro M3 (macOS). Source via: source tools/env.sh macbook
# Ports and camera indices confirmed on 2026-09-27. Ports are stable per physical device on macOS
# (named after the board serial), so they survive replugging and reboots — unlike Linux ACM numbers.
# Re-run tools/find_ports.sh only if an arm is swapped for another board.

export MACHINE=macbook
export LEROBOT_DIR="$HOME/GitHub/AnotherOnes/lerobot"   # same path as the desktop (0.6.2-dev checkout)
export RUN="uv run"                          # or "" inside an activated venv/conda env
export DEVICE=mps                            # Apple Silicon GPU; cpu as fallback. No CUDA.

export ROBOT_TYPE=so100_follower
export ROBOT_ID=my_awesome_follower_arm      # same id as the desktop — calibration travels with the repo
export ROBOT_PORT=/dev/tty.usbmodem58FA0929601   # follower (2026-09-27)

export TELEOP_TYPE=so100_leader
export TELEOP_ID=my_awesome_leader_arm
export TELEOP_PORT=/dev/tty.usbmodem58FA0929691  # leader   (2026-09-27)

# macOS has no /dev/v4l/by-id, so these are bare AVFoundation indices and they SHIFT whenever a
# camera, a hub, or the iPhone Continuity Camera appears or disappears. Turn Continuity Camera off
# (iPhone > Settings > General > AirPlay & Continuity) so it stops occupying an index, and re-verify
# with `tools/mac_cameras.sh` after every replug. Keys (top/wrist/base) must never change — they are
# baked into the dataset (lessons/camera-keys-are-baked-in.md).
# Pre-flight before any long session: uv run python tools/check_cameras.py
export CAM_TOP="top: {type: opencv, index_or_path: 1, width: 640, height: 480, fps: 30, fourcc: MJPG}"
export CAM_WRIST="wrist: {type: opencv, index_or_path: 2, width: 640, height: 480, fps: 30, fourcc: MJPG}"
export CAM_BASE="base: {type: opencv, index_or_path: 3, width: 640, height: 480, fps: 30, fourcc: MJPG}"
export CAMERAS="{ ${CAM_TOP}, ${CAM_WRIST}, ${CAM_BASE} }"   # three cameras: the demo policy needs all three
export CAMERAS_TWO="{ ${CAM_TOP}, ${CAM_WRIST} }"
export CAMERAS_THREE="{ ${CAM_TOP}, ${CAM_WRIST}, ${CAM_BASE} }"
export CAMERAS_TOP_ONLY="{ ${CAM_TOP} }"

# On the Mac the point is to push datasets so HF Jobs can train them. Set HF_USER after `hf auth login`.
export HF_USER="${HF_USER:-Youngermaster}"   # confirmed 2026-09-27 via `hf auth whoami`
export DATASET_PREFIX="${HF_USER}"           # datasets recorded here go straight to the Hub
export PUSH_TO_HUB=true

# The policy the demo runs (tools/demo.sh). A Hub id works offline once `tools/pull.sh policy <name>`
# has cached it — do that before leaving wifi.
export DEMO_POLICY="${HF_USER}/smolvla_so100_medicamentos"   # two instructions, three cameras

# The two stage instructions (tools/demo_live.sh starts with TASK1; type /subtask for TASK2).
# These MUST be the exact strings the datasets were recorded with — workflows/14-two-instruction-demo.md.
export DEMO_TASK1="agarra la caja de Complejo B"
export DEMO_TASK2="agarra el frasco de zinc"
export NUM_WORKERS=4
export BATCH_SIZE=4
